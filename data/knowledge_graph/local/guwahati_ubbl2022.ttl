kg:ubbl_24_a_ii a strata:Clause ; strata:inStandard kg:AssamUBBL2022 ;
    strata:clauseId "Bye-law 24(a)(ii), side and rear setback table" ; strata:page "9724" ;
    strata:quote "SIDE AND REAR SETBACK ... Height of the building | Side and Rear Open space to be left around the Building 1 9.6 m 1.8m 2 12.6m 2.4m 3 15.6m 3.6 m ... If the building height is in between two building heights specified above and if it exceeds 10% subject to maximum 1.5 m the higher height will be considered" .

kg:req_side_setback_h9_6 a strata:Requirement ;
    strata:appliesTo strata:Plot ; strata:quantity strata:sideSetback ; strata:comparator "ge" ;
    strata:value 1.8 ; strata:unit "m" ; strata:citedBy kg:ubbl_24_a_ii ;
    strata:condition [ a strata:Condition ; strata:onParameter strata:heightOfBuilding ; strata:maxInclusive 9.6 ] ;
    strata:jurisdiction strata:Guwahati ; strata:layer "A" ; strata:matrixItem "C2" ; strata:status "transcribed" ;
    strata:note "A height up to 10% (max 1.5 m) over a row still uses that row; beyond it the next row applies." .

kg:req_rear_setback_h9_6 a strata:Requirement ;
