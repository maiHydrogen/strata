kg:ubbl_24_b a strata:Clause ; strata:inStandard kg:AssamUBBL2022 ;
    strata:clauseId "Bye-law 24(b), minimum plot size for residential use" ; strata:page "9725" ;
    strata:quote "MINIMUM PLOT SIZE FOR RESIDENTIAL USE ... (a) The minimum size of plot for residential building within ULB area to be 134 sq.m. 6.0m. (b) The minimum size of plot for residential building outside ULB area to be 200 sq.m. 7.50 m." .

kg:req_plot_area_in_ulb a strata:Requirement ;
    strata:appliesTo strata:Plot ; strata:quantity strata:area ; strata:comparator "ge" ;
    strata:value 134.0 ; strata:unit "m2" ; strata:citedBy kg:ubbl_24_b ;
    strata:condition [ a strata:Condition ; strata:onParameter strata:insideULB ; strata:equals "yes" ] ;
    strata:jurisdiction strata:Guwahati ; strata:layer "A" ; strata:matrixItem "B1" ; strata:status "transcribed" .

kg:req_plot_width_in_ulb a strata:Requirement ;
    strata:appliesTo strata:Plot ; strata:quantity strata:width ; strata:comparator "ge" ;
    strata:value 6.0 ; strata:unit "m" ; strata:citedBy kg:ubbl_24_b ;
    strata:condition [ a strata:Condition ; strata:onParameter strata:insideULB ; strata:equals "yes" ] ;
    strata:jurisdiction strata:Guwahati ; strata:layer "A" ; strata:matrixItem "B1" ; strata:status "transcribed" .

kg:req_plot_area_outside_ulb a strata:Requirement ;
    strata:appliesTo strata:Plot ; strata:quantity strata:area ; strata:comparator "ge" ;
    strata:value 200.0 ; strata:unit "m2" ; strata:citedBy kg:ubbl_24_b ;
    strata:condition [ a strata:Condition ; strata:onParameter strata:insideULB ; strata:equals "no" ] ;
    strata:jurisdiction strata:Guwahati ; strata:layer "A" ; strata:matrixItem "B1" ; strata:status "transcribed" .

kg:req_plot_width_outside_ulb a strata:Requirement ;
    strata:appliesTo strata:Plot ; strata:quantity strata:width ; strata:comparator "ge" ;
    strata:value 7.5 ; strata:unit "m" ; strata:citedBy kg:ubbl_24_b ;
    strata:condition [ a strata:Condition ; strata:onParameter strata:insideULB ; strata:equals "no" ] ;
    strata:jurisdiction strata:Guwahati ; strata:layer "A" ; strata:matrixItem "B1" ; strata:status "transcribed" .

kg:ubbl_26_a a strata:Clause ; strata:inStandard kg:AssamUBBL2022 ;
    strata:clauseId "Bye-law 26(a), FAR table" ; strata:page "9730" ;
    strata:quote "FLOOR AREA RATIO (FAR) for Residential, Commercial, Mixed-Use ... Base FAR | Existing Road Width | Plot Size up to 670 sq m | above 670 sq m up to 1338 sq m ... 100 Above 3.6 upto 4.5 125 125 ... 125 Above 4.5 upto 6.6 125 125 ... 150 Above 6.6 upto 8.0 150 160 ... 150 Above 8.0 upto 15 150 175 ... 160 Above 15 175 200" .

kg:req_far_base_3_6to4_5 a strata:Requirement ;
    strata:appliesTo strata:Plot ; strata:quantity strata:far ; strata:comparator "le" ;
    strata:value 1.00 ; strata:unit "ratio" ; strata:citedBy kg:ubbl_26_a ;
    strata:condition [ a strata:Condition ; strata:onParameter strata:roadWidth ; strata:minExclusive 3.6 ; strata:maxInclusive 4.5 ] ;
    strata:jurisdiction strata:Guwahati ; strata:layer "A" ; strata:matrixItem "C4" ; strata:status "assumed" ;
    strata:note "26(a) was the FAR table for residential and mixed use (heading as amended 2024); the 2025 amendment substituted 26(a) with a table headed commercial and institutional buildings whose rows up to 15 m roads carry the same values. Confirm with GMDA which table governs residential plots." .

