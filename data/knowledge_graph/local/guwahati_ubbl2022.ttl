@prefix strata: <https://strata.iitg.ac.in/kg#> .
@prefix kg:     <https://strata.iitg.ac.in/kg/id/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

# Assam Unified Building Construction (Regulation) Byelaws, 2022, as amended in 2024, 2025
# and 2026. They apply to the Guwahati master plan area under the Assam Building Construction
# (Regulation) Act, 2010 (renamed and extended statewide by the Amendment Act, 2022).
# Chapter III Part I (bye-laws 22-33) is written for the city of Guwahati. Values transcribed
# from OCR of the gazette scans (data/reference_docs/gmda/ocr/); pages are gazette pages.
# The amendments list their changes in bye-law order: none touches 24(a) or 24(b).

kg:AssamUBBL2022 a strata:Standard ;
    rdfs:label "Assam Unified Building Construction (Regulation) Byelaws, 2022 (amended 2024, 2025, 2026)" ;
    strata:edition "2022, amended 20 Nov 2024, 25 Jul 2025, 4 Aug 2026" ;
    strata:sourceFile "data/reference_docs/gmda/assam-unified-building-construction-regulation-byelaws-2022.pdf",
                      "data/reference_docs/gmda/assam-unified-building-construction-regulation-amendment-byelaws-2024.pdf",
                      "data/reference_docs/gmda/assam-unified-building-construction-regulation-byelaws-25th-july2025amendments.pdf",
                      "data/reference_docs/gmda/assam-unified-building-construction-regulation-amendment-byelaws-2026.pdf" ;
    strata:legallyBinding true .


kg:ubbl_24_a_i a strata:Clause ; strata:inStandard kg:AssamUBBL2022 ;
    strata:clauseId "Bye-law 24(a)(i), front setback table" ; strata:page "9723-9724" ;
    strata:quote "Every building fronting a street shall have a front space from the prescribed street line ... Existing width of Street fronting the plot | Upto 9.6m | Up to 15.6 m | Above 15.6m ... Up to 6.6 Mts. 3.6m 4.5 Mts. 6.0 Mts. More than 6.6 to 15.0 Mts. 4.5m 6.0 Mts. 7.5 Mts. More than 15.0 to 24.0 Mts. 6.0m 7.5 Mts. 9.0 Mts. More than 24.0 to 45.0 Mts. 6.0m 9.0 Mts. 12.0 Mts. More than 45.0 Mts. 7.5m 12.0 Mts. 15.0 Mts. * Assuming 0.6 m to be the plinth height" .

kg:req_front_setback_upto6_6_h9_6 a strata:Requirement ;
    strata:appliesTo strata:Plot ; strata:quantity strata:frontSetback ; strata:comparator "ge" ;
    strata:value 3.6 ; strata:unit "m" ; strata:citedBy kg:ubbl_24_a_i ;
    strata:condition [ a strata:Condition ; strata:onParameter strata:roadWidth ; strata:maxInclusive 6.6 ] ;
    strata:condition [ a strata:Condition ; strata:onParameter strata:heightOfBuilding ; strata:maxInclusive 9.6 ] ;
    strata:jurisdiction strata:Guwahati ; strata:layer "A" ; strata:matrixItem "C2" ; strata:status "transcribed" ;
    strata:note "Measured from the prescribed street line, which may lie inside the plot where the road is to be widened (bye-law 23)." .

