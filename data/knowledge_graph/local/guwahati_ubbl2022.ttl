kg:req_far_base_over15 a strata:Requirement ;
    strata:appliesTo strata:Plot ; strata:quantity strata:far ; strata:comparator "le" ;
    strata:value 1.60 ; strata:unit "ratio" ; strata:citedBy kg:ubbl_26_a ;
    strata:condition [ a strata:Condition ; strata:onParameter strata:roadWidth ; strata:minExclusive 15.0 ] ;
    strata:jurisdiction strata:Guwahati ; strata:layer "A" ; strata:matrixItem "C4" ; strata:status "assumed" ;
    strata:note "26(a) was the FAR table for residential and mixed use (heading as amended 2024); the 2025 amendment substituted 26(a) with a table headed commercial and institutional buildings whose rows up to 15 m roads carry the same values. Confirm with GMDA which table governs residential plots." .

kg:req_far_max_over15_plot670 a strata:Requirement ;
    strata:appliesTo strata:Plot ; strata:quantity strata:farWithPremium ; strata:comparator "le" ;
    strata:value 1.75 ; strata:unit "ratio" ; strata:citedBy kg:ubbl_26_a ;
    strata:condition [ a strata:Condition ; strata:onParameter strata:roadWidth ; strata:minExclusive 15.0 ] ;
    strata:condition [ a strata:Condition ; strata:onParameter strata:plotArea ; strata:maxInclusive 670.0 ] ;
    strata:jurisdiction strata:Guwahati ; strata:layer "A" ; strata:matrixItem "C4" ; strata:status "assumed" ;
    strata:note "26(a) was the FAR table for residential and mixed use (heading as amended 2024); the 2025 amendment substituted 26(a) with a table headed commercial and institutional buildings whose rows up to 15 m roads carry the same values. Confirm with GMDA which table governs residential plots." .

kg:req_far_max_over15_plot1338 a strata:Requirement ;
    strata:appliesTo strata:Plot ; strata:quantity strata:farWithPremium ; strata:comparator "le" ;
    strata:value 2.00 ; strata:unit "ratio" ; strata:citedBy kg:ubbl_26_a ;
    strata:condition [ a strata:Condition ; strata:onParameter strata:roadWidth ; strata:minExclusive 15.0 ] ;
    strata:condition [ a strata:Condition ; strata:onParameter strata:plotArea ; strata:minExclusive 670.0 ; strata:maxInclusive 1338.0 ] ;
    strata:jurisdiction strata:Guwahati ; strata:layer "A" ; strata:matrixItem "C4" ; strata:status "assumed" ;
    strata:note "26(a) was the FAR table for residential and mixed use (heading as amended 2024); the 2025 amendment substituted 26(a) with a table headed commercial and institutional buildings whose rows up to 15 m roads carry the same values. Confirm with GMDA which table governs residential plots." .

kg:ubbl_app1_res a strata:Clause ; strata:inStandard kg:AssamUBBL2022 ;
    strata:clauseId "Appendix-I, Sl. 1 Residential Buildings" ; strata:page "9798" ;
    strata:quote "Residential Buildings/ Group Housing / Apartment Building | Car: 1 per Dwelling Unit measuring 66 Sqm and above in carpet area; 2 Per Dwelling Unit measuring 120 sq m and above in carpet area including units constructed under PMAY. | Two Wheeler: 1 per Dwelling unit of 66 sq.m. of carpet area or below." .

kg:req_parking_car_66to120 a strata:Requirement ;
    strata:appliesTo strata:DwellingUnit ; strata:quantity strata:parkingSpaces ; strata:comparator "ge" ;
    strata:value 1.0 ; strata:unit "spaces" ; strata:citedBy kg:ubbl_app1_res ;
    strata:condition [ a strata:Condition ; strata:onParameter strata:carpetArea ; strata:minInclusive 66.0 ; strata:maxExclusive 120.0 ] ;
    strata:jurisdiction strata:Guwahati ; strata:layer "A" ; strata:matrixItem "C6" ; strata:status "transcribed" .

kg:req_parking_car_120 a strata:Requirement ;
    strata:appliesTo strata:DwellingUnit ; strata:quantity strata:parkingSpaces ; strata:comparator "ge" ;
    strata:value 2.0 ; strata:unit "spaces" ; strata:citedBy kg:ubbl_app1_res ;
    strata:condition [ a strata:Condition ; strata:onParameter strata:carpetArea ; strata:minInclusive 120.0 ] ;
    strata:jurisdiction strata:Guwahati ; strata:layer "A" ; strata:matrixItem "C6" ; strata:status "transcribed" .

kg:req_parking_2w_upto66 a strata:Requirement ;
    strata:appliesTo strata:DwellingUnit ; strata:quantity strata:twoWheelerSpaces ; strata:comparator "ge" ;
    strata:value 1.0 ; strata:unit "spaces" ; strata:citedBy kg:ubbl_app1_res ;
    strata:condition [ a strata:Condition ; strata:onParameter strata:carpetArea ; strata:maxInclusive 66.0 ] ;
    strata:jurisdiction strata:Guwahati ; strata:layer "A" ; strata:matrixItem "C6" ; strata:status "transcribed" ;
    strata:note "Read as: a unit of up to 66 m2 carpet area needs one two-wheeler space instead of a car space." .

kg:ubbl_app1_space a strata:Clause ; strata:inStandard kg:AssamUBBL2022 ;
    strata:clauseId "Appendix-I, area of each car space" ; strata:page "9800" ;
    strata:quote "For calculation of car space the following shall be considered: Area of each car space- (i) Basement parking-30 sq. m. (ii) Stilt-25 sq. m. (iii) Open Parking-20 sq. m." .

kg:req_car_space_open a strata:Requirement ;
    strata:appliesTo strata:CarSpace ; strata:quantity strata:area ; strata:comparator "ge" ;
    strata:value 20.0 ; strata:unit "m2" ; strata:citedBy kg:ubbl_app1_space ;
    strata:condition [ a strata:Condition ; strata:onParameter strata:parkingType ; strata:equals "open" ] ;
    strata:jurisdiction strata:Guwahati ; strata:layer "A" ; strata:matrixItem "C6" ; strata:status "transcribed" ;
    strata:note "Includes circulation; the net car space is 13.75 m2 (Appendix-I, p. 9801)." .

kg:req_car_space_stilt a strata:Requirement ;
    strata:appliesTo strata:CarSpace ; strata:quantity strata:area ; strata:comparator "ge" ;
    strata:value 25.0 ; strata:unit "m2" ; strata:citedBy kg:ubbl_app1_space ;
    strata:condition [ a strata:Condition ; strata:onParameter strata:parkingType ; strata:equals "stilt" ] ;
    strata:jurisdiction strata:Guwahati ; strata:layer "A" ; strata:matrixItem "C6" ; strata:status "transcribed" .

kg:req_car_space_basement a strata:Requirement ;
    strata:appliesTo strata:CarSpace ; strata:quantity strata:area ; strata:comparator "ge" ;
    strata:value 30.0 ; strata:unit "m2" ; strata:citedBy kg:ubbl_app1_space ;
    strata:condition [ a strata:Condition ; strata:onParameter strata:parkingType ; strata:equals "basement" ] ;
    strata:jurisdiction strata:Guwahati ; strata:layer "A" ; strata:matrixItem "C6" ; strata:status "transcribed" .

kg:ubbl_app1_note1 a strata:Clause ; strata:inStandard kg:AssamUBBL2022 ;
    strata:clauseId "Appendix-I, Note 1" ; strata:page "9801" ;
    strata:quote "The minimum width of circulation driveway to be provided for adequate maneuvering of vehicles shall be 3.6 m for cars." .

kg:req_driveway_width a strata:Requirement ;
    strata:appliesTo strata:Driveway ; strata:quantity strata:width ; strata:comparator "ge" ;
    strata:value 3.6 ; strata:unit "m" ; strata:citedBy kg:ubbl_app1_note1 ;
    strata:jurisdiction strata:Guwahati ; strata:layer "A" ; strata:matrixItem "C6" ; strata:status "transcribed" .

kg:ubbl_app6 a strata:Clause ; strata:inStandard kg:AssamUBBL2022 ;
    strata:clauseId "Appendix-VI (bye-law 38(i)), buildings other than commercial and residential apartments" ; strata:page "9809" ;
    strata:quote "For all types of Buildings except Commercial and Residential Apartment Buildings (a) Percolation Pits: In areas around the buildings, percolation pits of size 1.2m x 1.2m x 1.5m shall be provided at the rate of 1 nos. such pit for every 100 sq.m. of Plot area. ... (b) Storage and re-use: All buildings with plot area 134sq m and above shall have the provision of rain water harvesting storage and reuse." .

kg:req_rwh_pits a strata:Requirement ;
    strata:appliesTo strata:Plot ; strata:quantity strata:percolationPits ; strata:comparator "ge" ;
    strata:value 0.01 ; strata:unit "pits per m2 of plot area" ; strata:citedBy kg:ubbl_app6 ;
    strata:condition [ a strata:Condition ; strata:onParameter strata:buildingType ; strata:equals "house" ] ;
    strata:jurisdiction strata:Guwahati ; strata:layer "P" ; strata:matrixItem "C7" ; strata:status "transcribed" ;
    strata:note "One pit of 1.2 x 1.2 x 1.5 m per 100 m2 of plot area; rain and waste water drains discharge through the pits." .

kg:req_rwh_storage a strata:Requirement ;
    strata:appliesTo strata:Plot ; strata:quantity strata:rainwaterStorage ; strata:comparator "eq" ;
    strata:valueText "required" ; strata:citedBy kg:ubbl_app6 ;
    strata:condition [ a strata:Condition ; strata:onParameter strata:buildingType ; strata:equals "house" ] ;
    strata:condition [ a strata:Condition ; strata:onParameter strata:plotArea ; strata:minInclusive 134.0 ] ;
    strata:jurisdiction strata:Guwahati ; strata:layer "P" ; strata:matrixItem "C7" ; strata:status "transcribed" .
